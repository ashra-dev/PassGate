# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=passgate
DB_USER=aakritmhrzn
DB_PASSWORD=

# Application base URL (no trailing slash) – used for magic-link emails
APP_URL=http://localhost:8000

# Local dev: write magic links to dev_login.log instead of SMTP (set to 0 in production)
APP_DEBUG=1

# SMTP (required in production when APP_DEBUG=0)
# Example providers: Resend (smtp.resend.com), SendGrid, Mailgun, Gmail
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=PassGate Pro

# Station terminal PIN (optional fallback when STATION_PIN_ENABLED=1)
STATION_PIN=1111
STATION_PIN_ENABLED=1

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=npr

